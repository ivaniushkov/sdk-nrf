config BT_CTLR_SDC_LOG
	bool "Enable SoftDevice Controller logging"
	depends on BT_LL_SOFTDEVICE_MULTIROLE
	depends on SOC_SERIES_NRF54L || SOC_SERIES_BSIM_NRF54LX
	select MPSL_LOG_HANDLER
	select EXPERIMENTAL
	help
	  Contribute the SoftDevice Controller message table to the shared MPSL
	  log handler (see CONFIG_MPSL_LOG_HANDLER), independently of
	  CONFIG_MPSL_LOG. Can be used to simplify debugging of HCI errors or
	  other kinds of SDC failures.
	  Note: it is only available on the SoftDevice Controller build variant
	  that has logging support built in (see the "logging" feature in
	  dragoon/softdevice_variants_config.yaml and the build_variant
	  selection in dragoon/zephyr/sdc_for_ncs.cmake).
